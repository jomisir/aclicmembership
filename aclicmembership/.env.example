# Copy to .env.local for local development, and add the same three
# variables in Vercel → Project → Settings → Environment Variables.
#
# Find them in Supabase → Project Settings → API.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe to expose in the browser — the tables are
# locked down with RLS and this key can read nothing.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key. SERVER ONLY — never prefix it with
# NEXT_PUBLIC_ and never commit it. It bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional but recommended on Vercel: any long random string. Vercel's cron
# sends it to /api/keepalive, and the route rejects calls without it.
CRON_SECRET=
